# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP (Railway lo define automáticamente en producción)
PORT=3000

# Cadena de conexión a PostgreSQL
# Local:   postgresql://postgres:postgres@localhost:5432/nexpay
# Railway: ${{Postgres.DATABASE_URL}} (referencia interna, se configura en el panel)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexpay

# SSL para PostgreSQL: true | false (si se omite, se activa solo en producción)
DB_SSL=false

# Secreto para firmar los JWT (usa una cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# Origen permitido por CORS (URL del frontend en Vercel, sin "/" final)
# Admite varios separados por coma: https://nexpay.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Tasas de cambio (opcionales, tienen valores por defecto)
# Se usa la v2 porque la v1 no incluye COP
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
# Tiempo que se guardan las tasas en caché antes de volver a pedirlas
RATES_CACHE_TTL_SECONDS=3600
# Peso argentino (ARS): dólar MEP desde DolarApi, varía durante el día → caché corta (5 min)
DOLARAPI_BASE_URL=https://dolarapi.com/v1
ARS_RATES_CACHE_TTL_SECONDS=300

# Recargas con dinero ficticio para pruebas (POST /wallet/deposits). true | false
DEMO_DEPOSITS_ENABLED=true

# Login con Google (opcional). Client ID de Google Cloud → Google Auth Platform → Clientes.
# No es secreto; el "client secret" NO se usa en este flujo.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
