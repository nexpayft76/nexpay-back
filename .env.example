# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP (Railway lo define automáticamente en producción)
PORT=3000

# Cadena de conexión a PostgreSQL
# Local:   postgresql://postgres:postgres@localhost:5432/nexpay
# Railway: ${{Postgres.DATABASE_URL}} (referencia interna, se configura en el panel)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexpay

# SSL para PostgreSQL: true | false (si se omite, se activa solo en producción)
DB_SSL=false

# Secreto para firmar los JWT (usa una cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# Origen permitido por CORS (URL del frontend en Vercel, sin "/" final)
# Varios separados por coma. El "*" acepta letras, números y guiones (útil para previews de Vercel):
# FRONTEND_URL=https://nexpay-front.vercel.app,https://nexpay-front-*.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# URL usada en los enlaces de email. Para desarrollo local usa http://localhost:5173/;
# en producción configura la URL canónica del frontend desplegado.
FRONTEND_APP_URL=https://nexpay-front.vercel.app/

# Tasas de cambio (opcionales, tienen valores por defecto)
# USD/EUR/COP: Frankfurter v2 (tasa oficial diaria; la v1 no incluye COP)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
RATES_CACHE_TTL_SECONDS=3600
# ARS: dólar MEP desde DolarApi (varía durante el día, caché de 5 min)
DOLARAPI_BASE_URL=https://dolarapi.com/v1
ARS_RATES_CACHE_TTL_SECONDS=300
# Historial para gráficos: USD/EUR/COP desde Frankfurter; ARS (oficial, MEP, blue) desde ArgentinaDatos
ARGENTINADATOS_BASE_URL=https://api.argentinadatos.com/v1
HISTORY_CACHE_TTL_SECONDS=21600

# Recargas con dinero ficticio para pruebas (POST /api/wallets/me/deposits). true | false
DEMO_DEPOSITS_ENABLED=true

# Comisión por compra/venta/intercambio, en % del monto de origen (1 = 1%). Máximo 10.
# 0 = sin comisión (Demo 1). En la demo final se activa, ej. 1.
EXCHANGE_FEE_PERCENT=0

# Emails con acceso al CRUD de administración (/api/users, /api/wallets, /api/balances, /api/transactions,
# y crear/editar/borrar en /api/currencies). Separados por coma. Vacío = nadie (recomendado en producción).
ADMIN_EMAILS=

# AWS SES: credenciales y remitente verificado para el envío de correos (bienvenida, resumen de transacción y recargas)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=nexpay.team@gmail.com
